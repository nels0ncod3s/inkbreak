{
  "id": "./",
  "name": "INKBREAK",
  "short_name": "INKBREAK",
  "description": "A blue-ink-on-paper arena FPS and story game.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "landscape",
  "background_color": "#f2eee2",
  "theme_color": "#f2eee2",
  "categories": [
